# Royal Heritage Explorer — Environment Configuration Template
# Duplicate this file to create your local .env file:
# cp .env.example .env
# DO NOT commit .env or .env.local to GitHub!

# Google Gemini API Key (Required for HeritageStory AI & Conversational Assistant)
GEMINI_API_KEY=your_gemini_api_key_here

# Backend Server Port (Default: 3001)
PORT=3001
