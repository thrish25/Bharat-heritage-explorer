{
  "name": "royal-heritage-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node start_all.js",
    "dev": "vite --port=5173 --host=127.0.0.1",
    "server": "node --experimental-strip-types server/index.ts",
    "server:flask": "python backend/app.py",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "validate:reconstruction": "node --experimental-strip-types src/data/reconstruction/validateReconstructionData.ts",
    "test:story": "python backend/test_rag.py"
  },
  "dependencies": {
    "lucide-react": "^0.546.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.1",
    "puppeteer-core": "^25.17.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
